{
  "name": "bernskioldmedia/bm-page-specific-css",
  "description": "Allows editors to add styles specific for pages and post.",
  "type": "wordpress-plugin",
  "homepage": "https://bernskioldmedia.com",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bernskiold Media",
      "email": "info@bernskioldmedia.com",
      "homepage": "https://bernskioldmedia.com"
    }
  ],
  "support": {
    "source": "https://github.com/bernskiold/bm-page-specific-css",
    "issues": "https://github.com/bernskiold/bm-page-specific-css/issues"
  },
  "require": {
    "php": ">=8.1",
    "composer/installers": "^1.0 || ^2.0",
    "matthiasmullie/minify": "^1.3"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "scripts": {
    "lint": "phpcs .",
    "lint-fix": "phpcbf .",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1"
    }
  }
}
