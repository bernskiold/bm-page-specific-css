{
  "name": "bm-page-specific-css",
  "version": "1.2.0",
  "description": "Allows editors to add styles specific for pages and post.",
  "private": true,
  "scripts": {
    "setup": "npm install && composer install && npm run build",
    "build": "wp-scripts build assets/scripts/src/editor.js --output-path=assets/scripts/dist",
    "start": "wp-scripts start assets/scripts/src/editor.js --output-path=assets/scripts/dist",
    "dev": "npm run start",
    "lint": "npm run lint:js && npm run lint:php",
    "lint:js": "wp-scripts lint-js ./assets/scripts/src",
    "lint:php": "composer run lint",
    "format": "wp-scripts format ./assets/scripts/src",
    "i18n": "npm run i18n:pot",
    "i18n:pot": "wp i18n make-pot . ./languages/bm-page-specific-css.pot --exclude=\"assets/scripts/src,node_modules,vendor\"",
    "i18n:json": "wp i18n make-json languages --no-purge",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "packages-update": "wp-scripts packages-update",
    "test": "npm run test:php",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/bm-page-specific-css composer test",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "author": {
    "name": "Bernskiold Media",
    "email": "info@bernskioldmedia.com",
    "url": "https://bernskioldmedia.com",
    "role": "developer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernskiold/bm-page-specific-css.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/bernskiold/bm-page-specific-css/issues"
  },
  "homepage": "https://github.com/bernskiold/bm-page-specific-css#readme",
  "dependencies": {
    "@wordpress/data": "^11.1.0",
    "@wordpress/editor": "^16.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/plugins": "^8.1.0",
    "ace-builds": "^1.45.2",
    "react-ace": "^15.0.0"
  },
  "devDependencies": {
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^37.1.0"
  }
}
